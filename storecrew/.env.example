PUBLIC_URL=https://storecrew-ai-studio.onrender.com
# Generate a random secret of at least 32 characters. Keep it stable across deploys.
STORECREW_SESSION_SECRET=
# Choose one authenticated AI provider. Never paste these in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_REQUEST_LIMIT=100
# Optional alternative/fallback, only if intentionally configured:
# AI_API_KEY=
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=
# AI_PROVIDER_NAME=
# Independent Shopify app credentials, not the ChatGPT connector:
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Enable ONLY after Shopify has granted this app the Theme API exemption.
SHOPIFY_THEME_UPLOAD_ENABLED=0
